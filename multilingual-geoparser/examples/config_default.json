{
  "ner_backend": "transformers",
  "hf_models": {
    "en": "Babelscape/wikineural-multilingual-ner",
    "de": "Babelscape/wikineural-multilingual-ner",
    "hi": "ai4bharat/IndicNER",
    "ta": "ai4bharat/IndicNER"
  },
  "ner_min_score": 0.5,
  "candidate_limit": 5,
  "cache_path": ".cache/geocode_cache.json",
